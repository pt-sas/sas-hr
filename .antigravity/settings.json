      "command(git describe)",
      "command(git describe *)",
      "command(git diff)",
      "command(git diff *)",
      "command(git grep)",
      "command(git grep *)",
      "command(git log)",
      "command(git log *)",
      "command(git ls-files)",
      "command(git ls-files *)",
      "command(git ls-tree)",
      "command(git ls-tree *)",
      "command(git merge-base)",
      "command(git merge-base *)",
      "command(git remote)",
      "command(git remote -v)",
      "command(git remote show *)",
      "command(git rev-parse)",
      "command(git rev-parse *)",
      "command(git show)",
      "command(git show *)",
      "command(git status)",
      "command(git status *)",
      "command(git tag)",
      "command(git tag *)",
      "command(grep)",
